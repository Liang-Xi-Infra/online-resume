---
import type { InferEntrySchema } from "astro:content";

type Props = InferEntrySchema<"basics">;

const { name, title, tagline, location, email, github, social = [] } = Astro.props;

const socialLinks = [
  ...social,
];
---

<header class="mb-12 animate-fade-in">
  <div class="flex items-start justify-between gap-6">
    <!-- Left: name + title -->
    <div>
      <h1 class="mb-1 text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100 md:text-5xl">
        {name}
      </h1>
      <p class="mb-1 text-xl font-medium text-brand-600 dark:text-brand-400">
        {title}
      </p>
      <p class="text-slate-500 dark:text-slate-400 max-w-xl">
        {tagline}
      </p>
    </div>

    <!-- Right: photo -->
    <img
      src="/me.jpg"
      alt={name}
      class="h-auto w-auto max-h-28 shrink-0 rounded object-contain"
    />
  </div>

  <!-- Contact row -->
  <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
    <span class="inline-flex items-center gap-1">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      {location}
    </span>

    <span class="inline-flex items-center gap-1">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      <a href={`mailto:${email}`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
        {email}
      </a>
    </span>

    {socialLinks.map((link) => (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
        </svg>
        {link.platform}
      </a>
    ))}
  </div>

</header>
