---
import Section from "../layout/Section.astro";
import type { InferEntrySchema } from "astro:content";

type Props = {
  items: InferEntrySchema<"education">;
};

const { items } = Astro.props;
---

<Section title="Education">
  <div class="space-y-6">
    {items.map((edu) => (
      <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 p-5">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
          <div>
            <h3 class="font-semibold text-slate-900 dark:text-slate-100">
              {edu.school}
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-400">
              {edu.degree} in {edu.field}
            </p>
          </div>
          <span class="text-sm font-mono text-slate-400 dark:text-slate-500 whitespace-nowrap">
            {edu.period}
          </span>
        </div>
        {edu.highlights && edu.highlights.length > 0 && (
          <ul class="mt-3 space-y-1 text-sm text-slate-500 dark:text-slate-400">
            {edu.highlights.map((h, i) => (
              <li class="flex gap-2">
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-slate-400" />
                <span>{h}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
</Section>
