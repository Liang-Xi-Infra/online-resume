---
import Section from "../layout/Section.astro";
import type { InferEntrySchema } from "astro:content";

type Props = {
  items: InferEntrySchema<"projects">;
};

const { items } = Astro.props;
---

<Section title="Projects">
  <div class="grid gap-4 sm:grid-cols-2">
    {items.map((proj) => (
      <div class="group rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 p-5 hover:border-brand-300 dark:hover:border-brand-600 hover:shadow-md transition-all">
        <div class="flex items-start justify-between gap-2">
          <h3 class="font-semibold text-slate-900 dark:text-slate-100">
            {proj.name}
          </h3>
          {proj.stars != null && (
            <span class="inline-flex items-center gap-1 shrink-0 text-xs text-amber-500">
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              {proj.stars}
            </span>
          )}
        </div>

        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          {proj.description}
        </p>

        {proj.highlights && proj.highlights.length > 0 && (
          <ul class="mt-3 space-y-1 text-xs text-slate-500 dark:text-slate-500">
            {proj.highlights.map((h, i) => (
              <li class="flex gap-1.5">
                <span class="mt-1 h-1 w-1 shrink-0 rounded-full bg-brand-400" />
                <span>{h}</span>
              </li>
            ))}
          </ul>
        )}

        <div class="mt-3 flex flex-wrap items-center gap-2">
          {proj.tech.map((t) => (
            <span class="rounded bg-slate-100 dark:bg-slate-700 px-2 py-0.5 text-xs font-mono text-slate-500 dark:text-slate-400">
              {t}
            </span>
          ))}
          {proj.github && (
            <a
              href={proj.github}
              target="_blank"
              rel="noopener noreferrer"
              class="ml-auto text-xs text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
            >
              GitHub →
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</Section>
