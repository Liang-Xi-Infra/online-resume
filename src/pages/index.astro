---
// Main Resume Page
// Imports all resume content at build time and passes data to display components.

import { getCollection } from "astro:content";
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/resume/Header.astro";
import Experience from "../components/resume/Experience.astro";
import Skills from "../components/resume/Skills.astro";
import Education from "../components/resume/Education.astro";
import Projects from "../components/resume/Projects.astro";
const [basicsEntry] = await getCollection("basics");
const [experienceEntry] = await getCollection("experience");
const [skillsEntry] = await getCollection("skills");
const [educationEntry] = await getCollection("education");
const [projectsEntry] = await getCollection("projects");

const basics = basicsEntry?.data;
const experience = experienceEntry?.data ?? [];
const skills = skillsEntry?.data ?? { categories: [] };
const education = educationEntry?.data ?? [];
const projects = projectsEntry?.data ?? [];
---

<BaseLayout title={`${basics?.name ?? "Liang Xi"} — ${basics?.title ?? "AI Infrastructure Engineer"}`}>
  <div class="stagger-children">
    <Header {...(basics ?? { name: "", title: "", tagline: "", location: "", email: "", github: "" })} />

    <Education items={education} />

    <Experience items={experience} />

    <Projects items={projects} />

    <Skills categories={skills.categories} />

    <div class="mb-12 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/30 px-5 py-3 text-sm text-slate-500 dark:text-slate-400">
      <p>
        <span class="font-medium text-slate-600 dark:text-slate-300">About the Gap</span>
        <ul class="mt-1 space-y-1">
          <li class="flex gap-2">
            <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-slate-400 dark:bg-slate-500" />
            <span>Done: Took the THU-CS Graduate Entrance Exam — missed the cutoff by a narrow margin.</span>
          </li>
          <li class="flex gap-2">
            <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-slate-400 dark:bg-slate-500" />
            <span>Unfortunate: Confronted with the first suspension of internal department transfers, despite meeting the score threshold.</span>
          </li>
          <li class="flex gap-2">
            <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-slate-400 dark:bg-slate-500" />
            <span>Choose: Entered industry directly — building real systems turned out to be a solid path, too.</span>
          </li>
        </ul>
      </p>
    </div>

    <footer class="mt-16 border-t border-slate-200 dark:border-slate-700 pt-6 text-center text-xs text-slate-400 dark:text-slate-500">
      <p>
        Built with <a href="https://astro.build" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Astro</a>
        {" · "}
        <a href="/terminal" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors font-mono">/terminal</a>
        {" · "}
        <a href="https://github.com/Liang-Xi-Infra/Resume" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Source</a>
      </p>
      <p class="mt-1">&copy; {new Date().getFullYear()} Liang Xi. All rights reserved.</p>
    </footer>
  </div>
</BaseLayout>
