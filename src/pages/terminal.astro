---
// Full-screen Terminal Mode
// Immersive shell-style interface for browsing the resume.

import BaseLayout from "../components/layout/BaseLayout.astro";
import Terminal from "../components/terminal/Terminal.astro";
---

<BaseLayout
  title="Terminal — Liang Xi"
  description="Interactive terminal interface to explore my resume. Type 'help' to get started."
>
  <div class="-my-12 md:-my-20 flex min-h-screen flex-col items-center justify-center px-0">
    <div class="mb-4 flex items-center gap-3">
      <a
        href="/"
        class="text-sm text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
      >
        ← Back to Resume
      </a>
      <span class="text-slate-300 dark:text-slate-600">|</span>
      <span class="text-xs font-mono text-slate-400 dark:text-slate-500">
        Type <strong class="text-slate-600 dark:text-slate-300">help</strong> to list commands
      </span>
    </div>

    <div class="w-full max-w-4xl">
      <div class="mb-2 flex items-center gap-2 rounded-t-lg bg-slate-800 px-4 py-2">
        <span class="h-3 w-3 rounded-full bg-red-500" />
        <span class="h-3 w-3 rounded-full bg-yellow-500" />
        <span class="h-3 w-3 rounded-full bg-green-500" />
        <span class="ml-2 font-mono text-xs text-slate-400">resume.sh — bash — 80×24</span>
      </div>
      <Terminal fullscreen />
    </div>

    <p class="mt-6 text-center text-xs text-slate-400 dark:text-slate-600">
      Press <kbd class="rounded border border-slate-300 dark:border-slate-600 px-1.5 py-0.5 font-mono text-[11px]">Ctrl+L</kbd> to clear &nbsp;|&nbsp;
      <kbd class="rounded border border-slate-300 dark:border-slate-600 px-1.5 py-0.5 font-mono text-[11px]">Ctrl+U</kbd> to kill line &nbsp;|&nbsp;
      <kbd class="rounded border border-slate-300 dark:border-slate-600 px-1.5 py-0.5 font-mono text-[11px]">↑↓</kbd> for history
    </p>
  </div>
</BaseLayout>
